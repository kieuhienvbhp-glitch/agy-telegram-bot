[Unit]
Description=Google Antigravity Telegram Bot Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/agy-telegram-bot
ExecStart=/home/ubuntu/agy-telegram-bot/venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Bảo mật tiến trình
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/agy-telegram-bot /home/ubuntu/.gemini /tmp

[Install]
WantedBy=multi-user.target
