# ================================================================
# AGY TELEGRAM BOT CONFIGURATION
# Dành cho triển khai trên Ubuntu 24.04 & Linux/Windows
# ================================================================

# Token nhận từ @BotFather trên Telegram (BẮT BUỘC)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Danh sách Telegram User ID được phép truy cập bot (phân cách bằng dấu phẩy)
# Ví dụ: 12345678,987654321
# Gợi ý: Chat với @userinfobot trên Telegram để lấy ID của bạn
ALLOWED_USER_IDS=

# Đường dẫn đến file thực thi agy CLI (mặc định là 'agy' nếu đã có trong $PATH)
# Nếu cài đặt tại đường dẫn riêng, hãy điền đầy đủ: ví dụ /usr/local/bin/agy hoặc /root/.local/bin/agy
AGY_BIN_PATH=agy

# Model mặc định khi bắt đầu cuộc trò chuyện mới
# Ví dụ: gemini-3.8-flash-high, gemini-3.8-flash-medium, gemini-3.1-pro-high, claude-sonnet-4-6
DEFAULT_MODEL=gemini-3.8-flash-high

# Mức độ suy luận (Reasoning effort) mặc định: low, medium, high
DEFAULT_EFFORT=high

# Thư mục làm việc mặc định (để trống nếu muốn "No Project" như Antigravity UI)
# Ví dụ trên Ubuntu: /home/ubuntu/projects
DEFAULT_PROJECT_DIR=

# Thư mục gốc Antigravity lưu trữ conversations & brain (mặc định: ~/.gemini/antigravity)
ANTIGRAVITY_HOME=~/.gemini/antigravity

# Thư mục lưu dữ liệu nội bộ của bot (database, file tải về)
STORAGE_DIR=./storage

# Tự động cấp quyền thực thi công cụ (tương đương --dangerously-skip-permissions)
AUTO_SKIP_PERMISSIONS=true

# Chạy lệnh trong sandbox hạn chế terminal (mặc định: false)
DEFAULT_SANDBOX=false
